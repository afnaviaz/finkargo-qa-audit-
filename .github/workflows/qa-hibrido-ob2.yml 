name: QA Híbrido — Registro UI + OB2 API

on:
  workflow_dispatch:
    inputs:
      ambiente:
        description: 'Ambiente'
        required: true
        type: choice
        options: [Testing, Staging]
        default: Testing
      pais:
        description: 'País'
        required: true
        type: choice
        options: [CO, MX]
        default: CO

jobs:
  registro-y-ob2:
    name: "🎭 Playwright → 📮 Newman OB2"
    runs-on: ip-192-168-1-9

    steps:
      # ── 1. Checkout ──────────────────────────────────────────────────────
      - name: Checkout repo
        uses: actions/checkout@v4

      # ── 2. Setup Node ────────────────────────────────────────────────────
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      # ── 3. Instalar deps Playwright ──────────────────────────────────────
      - name: Instalar dependencias Playwright
        working-directory: playwright
        run: npm ci

      - name: Instalar Chromium
        working-directory: playwright
        run: npx playwright install chromium --with-deps

      # ── 4. Determinar ambiente ───────────────────────────────────────────
      - name: Configurar ambiente
        id: config
        run: |
          PAIS_LOWER=$(echo "${{ inputs.pais }}" | tr '[:upper:]' '[:lower:]')
          AMB_LOWER=$(echo "${{ inputs.ambiente }}" | tr '[:upper:]' '[:lower:]')
          ENV_KEY="${AMB_LOWER}-${PAIS_LOWER}"

          if [ "${{ inputs.pais }}" = "MX" ]; then
            DOMAIN="finkargo.com.mx"
          else
            DOMAIN="finkargo.com.co"
          fi
          BASE_URL="https://app-${AMB_LOWER}.${DOMAIN}"

          echo "env_key=${ENV_KEY}"   >> $GITHUB_OUTPUT
          echo "base_url=${BASE_URL}" >> $GITHUB_OUTPUT
          echo "→ Ambiente: ${ENV_KEY}"
          echo "→ Base URL: ${BASE_URL}"

      # ── 5. Correr Playwright (registro + OTP) ────────────────────────────
      - name: 🎭 Playwright — Registro con verificación OTP
        working-directory: playwright
        env:
          ENV: ${{ steps.config.outputs.env_key }}
        run: |
          npx cucumber-js --tags @registro_completo
          echo "✓ Playwright terminó"

      # ── 6. Verificar que el usuario quedó guardado ───────────────────────
      - name: Verificar datos de usuario registrado
        run: |
          echo "=== Usuario registrado por Playwright ==="
          node -e "
            const fs = require('fs');
            const users = JSON.parse(fs.readFileSync('./playwright/data/registered-users.json', 'utf-8'));
            const last = users[users.length - 1];
            console.log('Email:   ' + last.email);
            console.log('Empresa: ' + (last.empresa || 'N/A'));
            console.log('NIT:     ' + (last.nit || 'N/A'));
          "

      # ── 7. Generar environment Newman ────────────────────────────────────
      - name: 🔗 Generar environment Newman desde datos de Playwright
        run: |
          node scripts/playwright_to_newman_bridge.js \
            --input    ./playwright/data/registered-users.json \
            --output   ./scripts/playwright_env_export.json \
            --base-url ${{ steps.config.outputs.base_url }} \
            --pais     ${{ inputs.pais }}

      # ── 8. Instalar Newman ────────────────────────────────────────────────
      - name: Instalar Newman
        run: |
          if ! command -v newman &> /dev/null; then
            npm install -g newman newman-reporter-htmlextra
          fi

      # ── 9. Descargar colección OB2 de Postman ────────────────────────────
      - name: Descargar colección OB2
        env:
          POSTMAN_API_KEY: ${{ secrets.POSTMAN_API_KEY }}
        run: |
          # Ajusta el collection_id al ID real del OB2 en Postman
          COLLECTION_ID="${{ secrets.OB2_COLLECTION_ID }}"
          curl -s \
            -H "X-Api-Key: ${POSTMAN_API_KEY}" \
            "https://api.getpostman.com/collections/${COLLECTION_ID}" \
            -o ./scripts/ob2_collection.json
          echo "✓ Colección OB2 descargada"

      # ── 10. Correr Newman con el usuario recién registrado ───────────────
      - name: 📮 Newman — OB2 con usuario recién registrado
        run: |
          TIMESTAMP=$(date +%Y%m%d_%H%M%S)
          REPORT_FILE="scripts/report_ob2_${{ inputs.pais }}_${TIMESTAMP}.html"

          newman run scripts/ob2_collection.json \
            --environment scripts/playwright_env_export.json \
            --reporters cli,htmlextra \
            --reporter-htmlextra-export "${REPORT_FILE}" \
            --reporter-htmlextra-title "OB2 — ${{ inputs.ambiente }} ${{ inputs.pais }}" \
            --insecure \
            || true

          echo "report_file=${REPORT_FILE}" >> $GITHUB_ENV
          echo "✓ Newman OB2 terminó"

      # ── 11. Subir reporte ─────────────────────────────────────────────────
      - name: Subir reporte
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: reporte-ob2-${{ inputs.ambiente }}-${{ inputs.pais }}
          path: scripts/report_ob2_*.html
          retention-days: 14

      # ── 12. Limpiar datos de usuario (opcional) ───────────────────────────
      - name: Limpiar datos de sesión
        if: always()
        run: |
          rm -f ./playwright/data/registered-users.json
          rm -f ./scripts/playwright_env_export.json
          echo "✓ Datos de sesión eliminados"